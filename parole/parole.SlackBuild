#!/bin/bash

# SlackBuild for parole
# 2026 bouboulov

PRGNAM=parole
VERSION=4.20.0
SRCNAM=parole
BUILD=${BUILD:-1}
TAG=${TAG:-_bbv}

ARCH=${ARCH:-x86_64}

CWD=$(pwd)
TMP=${TMP:-/tmp/SBo}
PKG=$TMP/package-$PRGNAM

if [ "$ARCH" = "i586" ]; then
  SLKCFLAGS="-O2 -march=i586 -mtune=i686"
  LIBDIRSUFFIX=""
elif [ "$ARCH" = "i686" ]; then
  SLKCFLAGS="-O2 -march=i686 -mtune=i686"
  LIBDIRSUFFIX=""
elif [ "$ARCH" = "x86_64" ]; then
  SLKCFLAGS="-O2 -fPIC"
  LIBDIRSUFFIX="64"
else
  SLKCFLAGS="-O2"
  LIBDIRSUFFIX=""
fi

set -e

rm -rf $PKG
mkdir -p $TMP $PKG
cd $TMP || exit 1

rm -rf $SRCNAM-$VERSION
tar xf $CWD/$SRCNAM-$VERSION.tar.?z* || exit 1
cd $SRCNAM-$VERSION || exit 1

chown -R root:root .
find . -perm 777 -exec chmod 755 {} \;
find . -perm 666 -exec chmod 644 {} \;

export CFLAGS="$SLKCFLAGS"
export CXXFLAGS="$SLKCFLAGS"

mkdir -p meson-build
cd meson-build || exit 1

meson setup .. \
  --prefix=/usr \
  --libdir=lib${LIBDIRSUFFIX} \
  --buildtype=release \
  --wrap-mode=nodownload \
  --auto-features=enabled

ninja
DESTDIR=$PKG ninja install

cd ..

# Documentation
mkdir -p $PKG/usr/doc/$PRGNAM-$VERSION

for f in AUTHORS COPYING ChangeLog NEWS README.md THANKS TODO; do
  [ -f "$TMP/$SRCNAM-$VERSION/$f" ] && \
    cp -a "$TMP/$SRCNAM-$VERSION/$f" $PKG/usr/doc/$PRGNAM-$VERSION
done

cat $CWD/$PRGNAM.SlackBuild \
  > $PKG/usr/doc/$PRGNAM-$VERSION/$PRGNAM.SlackBuild

# Fix permissions
find $PKG -type f -perm 777 -exec chmod 755 {} \;
find $PKG -type f -perm 666 -exec chmod 644 {} \;

# Strip binaries
strip --strip-unneeded \
  $PKG/usr/bin/* 2>/dev/null || true

# Package
cd $PKG || exit 1
/sbin/makepkg -l y -c n \
  $TMP/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.txz
